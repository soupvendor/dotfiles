{# Rendered by mise (mode = "template"), not symlinked — see [dotfiles] in
   mise.toml. `git config --global ...` writes to the RENDERED file and is
   overwritten on the next apply; capture such a change back into the repo with
   `mise bootstrap dotfiles add ~/.config/git/config`.

   Deliberately no [alias] section: the git shortcuts live in zsh/zshrc as
   g/gs/gaa/gpu/gpr. One concern, one owner. -#}
[core]
	editor = nvim
	pager = delta

[delta]
	navigate = true
	line-numbers = true

[interactive]
	diffFilter = delta --color-only

[diff]
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[fetch]
	prune = true

[rerere]
	enabled = true

{# Guarded so a machine with no mise.local.toml still renders a valid config
   rather than erroring. install.sh writes these vars, but nothing here depends
   on it having run. -#}
{% if vars?.git_email %}
[user]
	email = {{ vars.git_email }}
	name = {{ vars.git_name }}
{% endif %}
